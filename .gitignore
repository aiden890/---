# --- Heavy / generated artifacts (git으로 관리하지 않음) ---
# --- 대용량 vendor 소스
vendor/
integrations/rlinf_mibot/vendor/
integrations/rlinf_mibot/.env
integrations/*/results/

# 렌더링 영상 · 체크포인트 · 아카이브
*.mp4
*.pt
*.tar.gz
*.pkl

# rollout 결과물 (재현 가능, 원본은 서버/아카이브 보존)
rollouts/
rollouts-xiaomi-*/
rl-train-*/results/
# skill-SFT: heavy caches/checkpoints ignored; small manifests/segments kept
skill-sft-*/results/hf_cache/
skill-sft-*/results/out/
skill-sft-*/results/**/*.mp4
reward_audit_viewer/*.mp4
# 새 모델 실험 대용량 (체크포인트·결과·vendor) — 코드/설정/REPORT만 git
groot/checkpoints/
groot/results/
groot/logs/
pi05/checkpoints/
pi05/results/
*.safetensors
checkpoints/

# 파이썬 캐시
__pycache__/
*.pyc
.pytest_cache/

# 로그
logs/
*.log

# OS
.DS_Store

rl-train-*/results/skill_sft/hf_cache/
rl-train-*/data/skill_sft/hf_cache/

# eval rollout artifacts: keep small stats + SHA256SUMS as durable record,
# ignore heavy regenerable per-step jsonl (mp4 already ignored above)
videos/**/*_steps.jsonl
# ignore heavy regenerable dumps (raw per-sample chunks, per-step jsonl)
experiments/*/run*/probe_*_raw_full.json
experiments/*/*/*.jsonl
