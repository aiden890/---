# RLinf-MiBoT deployment — HOST configuration. Copy to `.env` and fill in.
# Contains ONLY path/host placeholders — NO secrets, NO credentials, NO tokens.
# Every value is host/server-specific and supplied at deploy time.
# ---------------------------------------------------------------------------

# --- Host mount paths (absolute paths on the NEW server) -------------------
# RoboCasa assets directory OR a pre-populated docker volume name (read-only).
RLINF_ASSETS=/REPLACE/with/robocasa/assets
# Xiaomi MiBoT checkpoint dir (must contain model-*.safetensors, config.json, ...).
RLINF_CHECKPOINT=/REPLACE/with/Xiaomi-Robotics-1-RoboCasa365
# Where results/logs/videos are written (created if missing).
RLINF_RESULTS=/REPLACE/with/results
# HF / pip / torch caches (persist between runs; keep off the image).
RLINF_CACHE=/REPLACE/with/cache

# --- GPU / compute selection ----------------------------------------------
# Which GPU(s) the container may use (docker --gpus value): "all" or "device=0".
RLINF_GPUS=all
# Host GPU compute capability -> build arg TORCH_CUDA_ARCH_LIST (preflight reports it).
#   RTX 3090 / A5000 = 8.6, A100 = 8.0, L40/4090 = 8.9, H100 = 9.0
RLINF_CUDA_ARCH=8.6
# Parallel build jobs for flash-attn (lower if the host has little RAM).
RLINF_MAX_JOBS=4

# --- Ports (trainer RPC server; bound to loopback inside the container net) -
RLINF_TRAINER_PORT=10088

# --- Pinned repository revision (kept in lockstep with REVISIONS.lock) ------
RLINF_COMMIT=bde6c918642abf9a4776cb1d5fabcc5087dfe195

# --- Image tag for this deployment ----------------------------------------
RLINF_IMAGE=rlinf-mibot:latest
